# Backend Production Environment Variables Template
# =================================================
# This file documents all environment variables needed for production deployment
# Set these values in Render dashboard for each service
#
# IMPORTANT: Never commit actual .env files with real values to version control!
# =================================================

# ===========================================
# SHARED VARIABLES (Required by all services)
# ===========================================

# Environment
NODE_ENV=production

# MongoDB Connection
# Use MongoDB Atlas connection string
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://thurnye:beatrics1992@cluster0.kxiri.mongodb.net/EasyMealRecipeDB?retryWrites=true&w=majority

# JWT Configuration
# Generate strong random secrets (min 32 characters)
# Use: openssl rand -base64 32
JWT_ACCESS_SECRET=Thisisdefinitelyaverysecretkeyimtellingyou$1r
JWT_REFRESH_SECRET=Thisisdefinitelyaverysecretkeyimtellingyou$1r
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# ===========================================
# API GATEWAY SPECIFIC VARIABLES
# ===========================================

PORT=8000

# Service URLs (Render Internal URLs)
# Format: https://<service-name>.railway.internal
# Example: https://foodie-auth-service.railway.internal
AUTH_SERVICE_URL=https://foodie-auth-service.railway.internal:3001
USER_SERVICE_URL=http://foodie-user-service.railway.internal:3002
RECIPE_SERVICE_URL=http://foodie-recipe-service.railway.internal:3003
COOKBOOK_SERVICE_URL=https://foodie-cookbook-service.railway.internal:3004
COMMUNITY_SERVICE_URL=https://foodie-community-service.railway.internal:3005
EVENT_SERVICE_URL=https://foodie-event-service.railway.internal:3006
CHAT_SERVICE_URL=https://foodie-chat-service.railway.internal:300
COMMUNICATION_SERVICE_URL=https://foodie-communication-service.railway.internal:3009



# Frontend Configuration
# Set to your deployed frontend URL
FRONTEND_URL=https://easymealrecipe.onrender.com

# CORS Configuration
# Set to your deployed frontend URL
CORS_ORIGIN=https://easymealrecipe.onrender.com

# Cookie Configuration
# Set to your root domain (without https://)
COOKIE_DOMAIN=https://easymealrecipe.onrender.com
COOKIE_SECURE=true

# ===========================================
# AUTH SERVICE SPECIFIC VARIABLES
# ===========================================

AUTH_PORT=3001

# ===========================================
# USER SERVICE SPECIFIC VARIABLES
# ===========================================

USER_PORT=3002

# ===========================================
# RECIPE SERVICE SPECIFIC VARIABLES
# ===========================================

RECIPE_PORT=3003

# ===========================================
# COOKBOOK SERVICE SPECIFIC VARIABLES
# ===========================================

COOKBOOK_PORT=3004

# ===========================================
# COMMUNITY SERVICE SPECIFIC VARIABLES
# ===========================================

COMMUNITY_PORT=3005

# ===========================================
# EVENT SERVICE SPECIFIC VARIABLES
# ===========================================

EVENT_PORT=3006


# ===========================================
# COMMUNICATION SERVICE SPECIFIC VARIABLES
# ===========================================

COMMUNICATION_PORT=3009

# ===========================================
# DEPLOYMENT CHECKLIST
# ===========================================
#
# 1. MongoDB Atlas Setup:
#    - Create a MongoDB Atlas cluster
#    - Create a database user with read/write permissions
#    - Whitelist Render IPs (or use 0.0.0.0/0 for all IPs)
#    - Get connection string and update MONGODB_URI
#
# 2. Generate Secrets:
#    - Run: openssl rand -base64 32 (for JWT_ACCESS_SECRET)
#    - Run: openssl rand -base64 32 (for JWT_REFRESH_SECRET)
#    - Use the SAME secrets across all services
#
# 3. Render Dashboard Configuration:
#    - Create all services using render.yaml
#    - Set environment variables for each service
#    - Wait for all services to deploy successfully
#    - Copy service URLs and update API Gateway service URLs
#
# 4. Frontend Configuration:
#    - Deploy frontend to Render
#    - Copy frontend URL
#    - Update FRONTEND_URL and CORS_ORIGIN in API Gateway
#    - Update REACT_APP_API_BASE_URL in frontend .env.production
#
# 5. Google OAuth Setup:
#    - Go to Google Cloud Console
#    - Add production URLs to authorized redirect URIs
#    - Update frontend React_App_GOOGLE_CALLBACK
#
# 6. Test Deployment:
#    - Test authentication flow
#    - Test all API endpoints
#    - Check service logs in Render dashboard
#
# ===========================================



