# ===========================================
# DEPLOYMENT CHECKLIST
# ===========================================
# 1. Create 9 services in Railway (one per microservice)
# 2. Set build commands for each:
#    - API Gateway: npm install && npm run build:gateway
#    - Auth: npm install && npm run build:auth
#    - User: npm install && npm run build:user
#    - Recipe: npm install && npm run build:recipe
#    - Cookbook: npm install && npm run build:cookbook
#    - Community: npm install && npm run build:community
#    - Event: npm install && npm run build:event
#    - Chat: npm install && npm run build:chat
#    - Communication: npm install && npm run build:communication
#
# 3. Set start commands for each:
#    - API Gateway: cd api-gateway && npm start
#    - Auth: cd services/auth-service && npm start
#    - User: cd services/user-service && npm start
#    - Recipe: cd services/recipe-service && npm start
#    - Cookbook: cd services/cookbook-service && npm start
#    - Community: cd services/community-service && npm start
#    - Event: cd services/event-service && npm start
#    - Chat: cd services/chat-service && npm start
#    - Communication: cd services/communication-service && npm start
#
# 4. Enable Public Networking for all services
# 5. Copy environment variables from above to each service
# 6. Deploy and test!
