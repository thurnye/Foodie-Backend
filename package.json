{
  "name": "foodie-backend",
  "version": "1.0.0",
  "description": "Foodie Blog Backend - Microservices Architecture",
  "private": true,
  "workspaces": [
    "api-gateway",
    "services/*",
    "libs"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:gateway\" \"npm run dev:auth\" \"npm run dev:user\" \"npm run dev:recipe\" \"npm run dev:cookbook\" \"npm run dev:community\"",
    "dev:gateway": "cd api-gateway && npm run dev",
    "dev:auth": "cd services/auth-service && npm run dev",
    "dev:user": "cd services/user-service && npm run dev",
    "dev:recipe": "cd services/recipe-service && npm run dev",
    "dev:cookbook": "cd services/cookbook-service && npm run dev",
    "dev:community": "cd services/community-service && npm run dev",
    "dev:chat": "cd services/chat-service && npm run dev",
    "build": "npm run build:libs && npm run build:gateway && npm run build:services",
    "build:libs": "cd libs && npm run build",
    "build:gateway": "cd api-gateway && npm run build",
    "build:services": "npm run build:auth && npm run build:user && npm run build:recipe",
    "build:auth": "cd services/auth-service && npm run build",
    "build:user": "cd services/user-service && npm run build",
    "build:recipe": "cd services/recipe-service && npm run build",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "seed": "ts-node scripts/seed/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "concurrently": "^8.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "pm2": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
